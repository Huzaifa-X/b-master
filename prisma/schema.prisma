generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            BigInt                          @id @default(autoincrement())
  name                          String?                         @db.VarChar(255)
  email                         String                          @unique @db.VarChar(255)
  password                      String?                         @db.VarChar(255)
  image                         String?                         @db.VarChar(255)
  isEmailVerified               Boolean                         @default(false)
  organization                  String?                         @db.VarChar(255)
  gender                        String?                         @db.VarChar(50)
  googleId                      String?                         @unique @db.VarChar(255)
  loginType                     String                          @default("email") @db.VarChar(20)
  status                        String                          @default("active") @db.VarChar(255)
  address                       String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  deletedAt                     DateTime?
  availableBalance              Decimal                         @default(0) @db.Decimal(10, 2)
  currency                      String                          @default("CHF") @db.VarChar(3)
  currentPlanId                 Int?
  lifetimeEarnings              Decimal                         @default(0) @db.Decimal(10, 2)
  pendingBalance                Decimal                         @default(0) @db.Decimal(10, 2)
  stripeConnectAccountId        String?                         @unique @db.VarChar(255)
  stripeConnectOnboarded        Boolean                         @default(false)
  stripeConnectPayoutsEnabled   Boolean                         @default(false)
  stripeConnectStatus           String?                         @db.VarChar(50)
  stripeCustomerId              String?                         @unique @db.VarChar(255)
  stripeSubscriptionId          String?                         @unique @db.VarChar(255)
  subscriptionPeriodEnd         DateTime?
  subscriptionStatus            String?                         @db.VarChar(50)
  cancelAtPeriodEnd             Boolean?                        @default(false) @map("cancel_at_period_end")
  scheduledPlanChangeId         Int?                            @map("scheduled_plan_change_id")
  // PRIVACY SETTINGS
  emailVisible                  Boolean                         @default(false) @map("email_visible")
  accounts                      Account[]
  artifactPermissions           ArtifactPermission[]
  artifactVersions              ArtifactVersion[]
  artifacts                     AssistantArtifact[]
  assistant_chat_members        assistant_chat_members[]
  sentMessages                  AssistantChatMessage[]
  initiatedChats                AssistantChat[]                 @relation("ChatInitiator")
  participatedChats             AssistantChat[]                 @relation("ChatParticipant")
  assistantContacts             AssistantContact[]
  assistant_group_chat_members  assistant_group_chat_members[]
  assistant_group_chat_messages assistant_group_chat_messages[]
  assistant_group_chats         assistant_group_chats[]
  newsFeedComments              AssistantNewsFeedComment[]
  newsFeedLikes                 AssistantNewsFeedLike[]
  newsFeeds                     AssistantNewsFeed[]
  assistantPins                 AssistantPin[]
  assistantPurchases            AssistantPurchase[]
  assistantUserChatMessages     AssistantUserChatMessage[]
  assistantUserChats            AssistantUserChat[]
  assistants                    Assistant[]
  connectors                    Connector[]
  newsFeedPermissions           NewsFeedPermission[]
  notifications                 Notification[]
  oauthStates                   OAuthState[]
  paymentsMade                  PaymentRecord[]                 @relation("PaymentPayer")
  paymentRecords                PaymentRecord[]                 @relation("PaymentRecipient")
  sessions                      Session[]
  usageMetrics                  UsageMetric[]
  currentPlan                   Plan?                           @relation(fields: [currentPlanId], references: [id])
  scheduledPlanChange           Plan?                           @relation("ScheduledPlanChange", fields: [scheduledPlanChangeId], references: [id])

  @@index([email])
  @@index([googleId])
  @@index([status])
  @@index([deletedAt])
  @@index([stripeCustomerId])
  @@index([stripeConnectAccountId])
  @@index([currentPlanId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       BigInt
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Plan {
  id                   Int       @id @default(autoincrement())
  title                String    @db.VarChar(255)
  description          String?
  period               String    @default("monthly") @db.VarChar(50)
  features             Json      @default("[]")
  amount               Decimal   @db.Decimal(10, 2)
  stripeProductId      String?   @db.VarChar(255)
  stripePriceId        String?   @db.VarChar(255)
  assistantLimit       Int       @default(1)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  subscribers          User[]
  scheduledSubscribers User[]    @relation("ScheduledPlanChange")

  @@index([period])
  @@index([isActive])
  @@map("plans")
}

model PaymentRecord {
  id                      BigInt              @id @default(autoincrement())
  userId                  BigInt
  payerUserId             BigInt?
  type                    String              @db.VarChar(50)
  amount                  Decimal             @db.Decimal(10, 2)
  currency                String              @default("CHF") @db.VarChar(3)
  platformFee             Decimal             @default(0) @db.Decimal(10, 2)
  netAmount               Decimal             @db.Decimal(10, 2)
  relatedType             String?             @db.VarChar(100)
  relatedId               BigInt?
  status                  String              @default("pending") @db.VarChar(50)
  stripePaymentIntentId   String?             @unique @db.VarChar(255)
  stripeChargeId          String?             @db.VarChar(255)
  stripeCheckoutSessionId String?             @unique @db.VarChar(255)
  stripeSubscriptionId    String?             @db.VarChar(255)
  stripeInvoiceId         String?             @db.VarChar(255)
  stripeTransferId        String?             @db.VarChar(255)
  stripePayoutId          String?             @db.VarChar(255)
  stripeRefundId          String?             @db.VarChar(255)
  description             String?
  metadata                Json?               @db.Json
  completedAt             DateTime?
  refundedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  assistantPurchases      AssistantPurchase[]
  payer                   User?               @relation("PaymentPayer", fields: [payerUserId], references: [id])
  user                    User                @relation("PaymentRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([payerUserId])
  @@index([type])
  @@index([status])
  @@index([relatedType, relatedId])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
  @@index([stripeSubscriptionId])
  @@index([createdAt])
  @@map("payment_records")
}

model Assistant {
  id                            BigInt                          @id @default(autoincrement())
  userId                        BigInt
  name                          String                          @db.VarChar(255)
  price                         Decimal                         @default(0)
  currency                      String                          @default("CHF") @db.VarChar(3)
  priceType                     String                          @default("paid") @db.VarChar(255)
  category                      AssistantCategory               @default(OTHER)
  description                   String?
  instructions                  String?
  image                         String?                         @db.VarChar(255)
  vectorStoreId                 String?                         @db.VarChar(255)
  public                        Boolean                         @default(true)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  deletedAt                     DateTime?
  buyerPermissions              String?
  isDeleted                     Boolean                         @default(false)
  stripePriceId                 String?                         @db.VarChar(255)
  stripeProductId               String?                         @db.VarChar(255)
  artifactPermissions           ArtifactPermission[]
  apiConfiguration              AssistantApiConfiguration?
  artifacts                     AssistantArtifact[]
  chatMessages                  AssistantChatMessage[]
  assistantChats                AssistantChat[]
  contacts                      AssistantContact[]
  assistant_group_chat_messages assistant_group_chat_messages[]
  assistant_group_chats         assistant_group_chats[]
  knowledgebases                AssistantKnowledgebase[]
  newsFeeds                     AssistantNewsFeed[]
  pins                          AssistantPin[]
  purchases                     AssistantPurchase[]
  userChatMessages              AssistantUserChatMessage[]
  userChats                     AssistantUserChat[]
  owner                         User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectors                    Connector[]
  usageMetrics                  UsageMetric[]

  @@index([userId])
  @@index([public])
  @@index([category])
  @@index([deletedAt])
  @@map("assistants")
}

model AssistantKnowledgebase {
  id           Int       @id @default(autoincrement())
  assistantId  BigInt
  url          String?
  note         String?
  file         String?
  type         String    @default("url") @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isCrawled    Boolean   @default(false)
  vectorFileId String?
  assistant    Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([isCrawled])
  @@map("assistant_knowledgebases")
}

model AssistantApiConfiguration {
  id                   Int       @id @default(autoincrement())
  assistantId          BigInt    @unique
  authenticationType   String    @default("none") @db.VarChar(50)
  apiKey               String?
  authType             String?   @db.VarChar(50)
  customHeaderName     String?   @db.VarChar(255)
  clientId             String?   @db.VarChar(255)
  clientSecret         String?
  authorizationUrl     String?
  tokenUrl             String?
  scope                String?
  tokenExchangeMethod  String?   @db.VarChar(50)
  schemaText           String?
  schema               Json?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tools                Json?
  customQueryParamName String?   @db.VarChar(255)
  accessToken          String?
  refreshToken         String?
  tokenExpiry          DateTime?
  assistant            Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@map("assistant_api_configurations")
}

model AssistantContact {
  id          Int       @id @default(autoincrement())
  assistantId BigInt
  userId      BigInt
  description String?
  role        String?   @db.VarChar(255)
  access      String    @default("admin") @db.VarChar(50)
  permissions String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  information String?
  telephone   String?   @db.VarChar(50)
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([userId])
  @@map("assistant_contacts")
}

model UsageMetric {
  id          BigInt     @id @default(autoincrement())
  assistantId BigInt?
  userId      BigInt
  inputToken  Int        @default(0)
  outputToken Int        @default(0)
  totalToken  Int        @default(0)
  totalCost   Float      @default(0)
  toolUsing   String?
  costType    String?    @db.VarChar(100)
  createdAt   DateTime   @default(now())
  assistant   Assistant? @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([userId])
  @@index([createdAt])
  @@map("usage_metrics")
}

model AssistantPurchase {
  id              Int            @id @default(autoincrement())
  buyerId         BigInt
  assistantId     BigInt
  purchaseDate    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paymentRecordId BigInt?
  deletedAt       DateTime?
  assistant       Assistant      @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  buyer           User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentRecord   PaymentRecord? @relation(fields: [paymentRecordId], references: [id])

  @@unique([buyerId, assistantId])
  @@index([buyerId])
  @@index([assistantId])
  @@index([paymentRecordId])
  @@index([deletedAt])
  @@map("assistant_purchases")
}

model AssistantUserChat {
  id              Int                        @id @default(autoincrement())
  userId          BigInt
  topic           String
  assistantId     BigInt?
  shareableId     String?                    @unique @db.VarChar(255)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?
  chatType        String
  messages        AssistantUserChatMessage[]
  assistant       Assistant?                 @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectorUsages ConnectorChatUsage[]

  @@index([userId])
  @@index([assistantId])
  @@index([shareableId])
  @@map("assistant_user_chats")
}

model AssistantUserChatMessage {
  id                  Int               @id @default(autoincrement())
  role                String            @db.VarChar(50)
  message             String?
  documents           String?
  userId              BigInt?
  assistantUserChatId Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  assistantId         BigInt?
  hasImages           Boolean           @default(false)
  openaiResponseId    String?           @db.VarChar(255)
  status              MessageStatus     @default(PENDING)
  assistant           Assistant?        @relation(fields: [assistantId], references: [id])
  chat                AssistantUserChat @relation(fields: [assistantUserChatId], references: [id], onDelete: Cascade)
  user                User?             @relation(fields: [userId], references: [id])

  @@index([assistantUserChatId])
  @@index([userId])
  @@index([assistantId])
  @@map("assistant_user_chat_messages")
}

model AssistantChat {
  id                     Int                      @id @default(autoincrement())
  assistantId            BigInt
  initiatorId            BigInt
  participantId          BigInt?
  isActive               Boolean                  @default(true)
  lastMessageAt          DateTime?
  lastMessageId          BigInt?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  groupName              String?                  @db.VarChar(255)
  isGroup                Boolean                  @default(false)
  assistant_chat_members assistant_chat_members[]
  messages               AssistantChatMessage[]   @relation("ChatMessages")
  assistant              Assistant                @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  initiator              User                     @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participant            User?                    @relation("ChatParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([assistantId, initiatorId, participantId])
  @@index([assistantId, initiatorId])
  @@index([assistantId, participantId])
  @@index([lastMessageId])
  @@index([isGroup])
  @@map("assistant_chats")
}

model AssistantChatMessage {
  id              BigInt        @id @default(autoincrement())
  assistantChatId Int
  assistantId     BigInt
  senderId        BigInt
  message         String
  messageType     String        @default("text") @db.VarChar(50)
  attachmentUrl   String?       @db.VarChar(255)
  attachmentName  String?       @db.VarChar(255)
  attachmentSize  BigInt?
  isRead          Boolean       @default(false)
  readAt          DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chat            AssistantChat @relation("ChatMessages", fields: [assistantChatId], references: [id], onDelete: Cascade)
  assistant       Assistant     @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  sender          User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([assistantChatId])
  @@index([assistantId])
  @@index([senderId])
  @@index([createdAt])
  @@map("assistant_chat_messages")
}

model AssistantNewsFeed {
  id           Int                        @id @default(autoincrement())
  assistantId  BigInt
  userId       BigInt
  content      String?
  isPublic     Boolean                    @default(true)
  likeCount    Int                        @default(0)
  commentCount Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  image        String?
  title        String?                    @db.VarChar(255)
  comments     AssistantNewsFeedComment[]
  likes        AssistantNewsFeedLike[]
  assistant    Assistant                  @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions  NewsFeedPermission[]

  @@index([assistantId])
  @@index([userId])
  @@index([isPublic])
  @@map("assistant_news_feeds")
}

model NewsFeedPermission {
  id         Int               @id @default(autoincrement())
  newsFeedId Int
  userId     BigInt
  createdAt  DateTime          @default(now())
  newsFeed   AssistantNewsFeed @relation(fields: [newsFeedId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsFeedId, userId])
  @@index([newsFeedId])
  @@index([userId])
  @@map("news_feed_permissions")
}

model AssistantNewsFeedLike {
  id         Int               @id @default(autoincrement())
  newsFeedId Int
  userId     BigInt
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  newsFeed   AssistantNewsFeed @relation(fields: [newsFeedId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsFeedId, userId])
  @@index([newsFeedId])
  @@index([userId])
  @@map("assistant_news_feed_likes")
}

model AssistantNewsFeedComment {
  id              Int                        @id @default(autoincrement())
  newsFeedId      Int
  userId          BigInt
  comment         String?
  parentCommentId Int?
  status          String                     @default("active") @db.VarChar(50)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  newsFeed        AssistantNewsFeed          @relation(fields: [newsFeedId], references: [id], onDelete: Cascade)
  parentComment   AssistantNewsFeedComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         AssistantNewsFeedComment[] @relation("CommentReplies")
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newsFeedId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("assistant_news_feed_comments")
}

model AssistantArtifact {
  id              Int                     @id @default(autoincrement())
  assistantId     BigInt
  userId          BigInt
  name            String?                 @db.VarChar(255)
  instructions    String?
  category        String?                 @db.VarChar(255)
  tools           Json?                   @db.Json
  apiKeys         Json?                   @db.Json
  isPublic        Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  files           Json?                   @db.Json
  images          Json?                   @db.Json
  thumbnailUrl    String?
  videoMetadata   Json?                   @db.Json
  videoUrl        String?
  activeVersionId Int?
  deletedAt       DateTime?
  shareableId     String?                 @unique @db.VarChar(255)
  generationJobs  ArtifactGenerationJob[]
  permissions     ArtifactPermission[]
  versions        ArtifactVersion[]
  activeVersion   ArtifactVersion?        @relation("ActiveVersion", fields: [activeVersionId], references: [id])
  assistant       Assistant               @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([userId])
  @@index([activeVersionId])
  @@index([shareableId])
  @@index([category])
  @@map("assistant_artifacts")
}

model ArtifactVersion {
  id                 Int                 @id @default(autoincrement())
  artifactId         Int
  userId             BigInt
  versionNumber      Int
  versionName        String?             @db.VarChar(255)
  code               String
  description        String?
  changeType         String              @default("manual") @db.VarChar(50)
  changedFrom        Int?
  isSnapshot         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  artifact           AssistantArtifact   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  creator            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForArtifacts AssistantArtifact[] @relation("ActiveVersion")

  @@unique([artifactId, versionNumber])
  @@index([artifactId])
  @@index([userId])
  @@index([versionNumber])
  @@index([createdAt])
  @@index([isSnapshot])
  @@map("artifact_versions")
}

model ArtifactPermission {
  id          Int                 @id @default(autoincrement())
  userId      BigInt
  assistantId BigInt
  artifactId  Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  access      ArtifactAccessLevel @default(VIEWER)
  artifact    AssistantArtifact   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  assistant   Assistant           @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artifactId])
  @@index([userId])
  @@index([artifactId])
  @@map("artifact_permissions")
}

model ArtifactGenerationJob {
  id          String            @id @default(cuid())
  artifactId  Int
  status      String            @default("pending") @db.VarChar(50)
  progress    Int               @default(0)
  result      String?
  error       String?
  metadata    Json?             @db.Json
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  artifact    AssistantArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([status])
  @@index([createdAt])
  @@map("artifact_generation_jobs")
}

model AssistantPin {
  id          Int       @id @default(autoincrement())
  userId      BigInt
  assistantId BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assistantId])
  @@index([userId])
  @@index([assistantId])
  @@map("assistant_pins")
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      BigInt
  title       String?   @db.VarChar(255)
  message     String?
  type        String?   @db.VarChar(100)
  relatedId   Int?
  relatedType String?   @db.VarChar(100)
  isRead      Boolean   @default(false)
  readAt      DateTime?
  data        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([relatedId, relatedType])
  @@map("notifications")
}

model Prompt {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  prompt    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("prompts")
}

model Connector {
  id                Int                  @id @default(autoincrement())
  userId            BigInt
  assistantId       BigInt?
  provider          ConnectorProvider
  name              String               @db.VarChar(255)
  description       String?
  accessToken       String
  refreshToken      String
  tokenExpiry       DateTime
  providerAccountId String?              @db.VarChar(255)
  providerEmail     String?              @db.VarChar(255)
  scopes            Json                 @default("[]")
  status            ConnectorStatus      @default(PENDING)
  requireApproval   String               @default("never") @db.VarChar(50)
  autoRefresh       Boolean              @default(true)
  config            Json?                @db.Json
  metadata          Json?                @db.Json
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  chatUsages        ConnectorChatUsage[]
  assistant         Assistant?           @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assistantId, provider])
  @@index([userId])
  @@index([assistantId])
  @@index([provider])
  @@index([status])
  @@map("connectors")
}

model ConnectorChatUsage {
  id                  Int               @id @default(autoincrement())
  connectorId         Int
  assistantUserChatId Int
  isActive            Boolean           @default(true)
  lastUsedAt          DateTime          @default(now())
  usageCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  chat                AssistantUserChat @relation(fields: [assistantUserChatId], references: [id], onDelete: Cascade)
  connector           Connector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, assistantUserChatId])
  @@index([connectorId])
  @@index([assistantUserChatId])
  @@map("connector_chat_usages")
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    BigInt
  provider  String   @db.VarChar(50)
  data      Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}

model assistant_chat_members {
  id              Int           @id @default(autoincrement())
  chatId          Int
  userId          BigInt
  role            String        @default("member") @db.VarChar(50)
  joinedAt        DateTime      @default(now())
  assistant_chats AssistantChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  users           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
}

model assistant_group_chat_members {
  id                    Int                   @id @default(autoincrement())
  groupChatId           Int
  userId                BigInt
  role                  String                @default("member") @db.VarChar(20)
  joinedAt              DateTime              @default(now())
  leftAt                DateTime?
  assistant_group_chats assistant_group_chats @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  users                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupChatId, userId])
  @@index([groupChatId])
  @@index([userId])
}

model assistant_group_chat_messages {
  id                    BigInt                @id @default(autoincrement())
  groupChatId           Int
  assistantId           BigInt
  senderId              BigInt
  message               String
  messageType           String                @default("text") @db.VarChar(50)
  attachmentUrl         String?               @db.VarChar(255)
  attachmentName        String?               @db.VarChar(255)
  attachmentSize        BigInt?
  deletedAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  assistants            Assistant             @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistant_group_chats assistant_group_chats @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  users                 User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([createdAt])
  @@index([groupChatId])
  @@index([senderId])
}

model assistant_group_chats {
  id                            Int                             @id @default(autoincrement())
  assistantId                   BigInt
  name                          String                          @db.VarChar(255)
  description                   String?                         @db.VarChar(500)
  avatarUrl                     String?                         @db.VarChar(255)
  createdById                   BigInt
  isActive                      Boolean                         @default(true)
  lastMessageAt                 DateTime?
  lastMessageId                 BigInt?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  deletedAt                     DateTime?
  assistant_group_chat_members  assistant_group_chat_members[]
  assistant_group_chat_messages assistant_group_chat_messages[]
  assistants                    Assistant                       @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  users                         User                            @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@index([createdById])
  @@index([lastMessageAt])
}

enum AssistantCategory {
  EDUCATION
  TRAVEL
  PROGRAMMING
  MARKETING
  ANALYSIS
  BOOKING
  OTHER
}

enum MessageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArtifactAccessLevel {
  VIEWER
  EDITOR
  ADMIN
}

enum ConnectorStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
  DISABLED
}

enum ConnectorProvider {
  DROPBOX
  GOOGLE
  SUPABASE
}
